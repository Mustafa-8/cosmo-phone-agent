# Copy to .env and fill in locally. Never commit .env
# Agent (ADK). Free tier: 15 requests/minute per Google project.
GOOGLE_API_KEY=
# Voice translation. Use a key from a DIFFERENT Google project so it gets its own quota.
# If left empty, translation falls back to GOOGLE_API_KEY and shares the agent's quota.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Voice layer (voice/). "auto" = real API when the key is set, mock otherwise. Force with real / mock.
STT_MODE=auto
TRANSLATE_MODE=auto
TTS_MODE=auto
# ElevenLabs realtime STT (Scribe). vad = server detects end of sentence; manual = commit() only.
STT_MODEL_ID=scribe_v3_live
STT_COMMIT_STRATEGY=vad
STT_VAD_SILENCE_SECS=0.9
# Comma separated words Scribe should bias toward (drug names, doctor names...)
STT_KEYTERMS=paracetamol,ibuprofen
# ElevenLabs TTS
TTS_MODEL_ID=eleven_flash_v2_5
TTS_OUTPUT_FORMAT=mp3_44100_128
TTS_SEND_LANGUAGE_CODE=true
VOICE_ID_EN=JBFqnCBsd6RMkjVDRZzb
# Hungarian voice: Andris (native Hungarian male, calm). First use of a library voice can take ~9 s, then ~0.2 s.
VOICE_ID_HU=rlxsbADLInnFyRAXDQLB
# Gemini model for translation (gemini-2.5-flash is closed to new users)
GEMINI_MODEL=gemini-3.5-flash-lite

# Agent model (first reply: 3.1-flash-lite ~3 s, 3.5-flash-lite 6-22 s in tests)
AGENT_MODEL=gemini-3.1-flash-lite

# Copy to .env and fill in locally. Never commit .env
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
TRANSLATION_GOOGLE_API_KEY=

# Local integration gateway and ADK API server
ADK_BASE_URL=http://127.0.0.1:8000
COSMO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "auto" uses the real provider when its key is configured; force "mock" for scripted testing
STT_MODE=auto
TRANSLATE_MODE=auto
TTS_MODE=auto

# ElevenLabs Scribe realtime speech recognition
STT_MODEL_ID=scribe_v3_live
STT_COMMIT_STRATEGY=vad
STT_VAD_SILENCE_SECS=0.9
STT_KEYTERMS=paracetamol,ibuprofen,TAJ

# ElevenLabs speech synthesis
TTS_MODEL_ID=eleven_flash_v2_5
TTS_OUTPUT_FORMAT=mp3_44100_128
TTS_SEND_LANGUAGE_CODE=true
VOICE_ID_EN=JBFqnCBsd6RMkjVDRZzb
VOICE_ID_HU=rlxsbADLInnFyRAXDQLB

# Gemini translation model
GEMINI_MODEL=gemini-3.5-flash-lite
